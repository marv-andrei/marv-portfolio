---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/site.css';
interface Props {title:string;description:string;active?:string;socialImage?:string;}
const {title,description,active='',socialImage='/images/social.jpg'}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#f7f7f5"/><title>{title} | Marv Pacinabao</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="icon" href="/favicon.ico" sizes="any"/><meta property="og:type" content="website"/><meta property="og:title" content={`${title} | Marv Pacinabao`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(socialImage,Astro.site)}/><meta property="og:image:alt" content="Marv Pacinabao landing page and funnel portfolio"/><meta name="twitter:card" content="summary_large_image"/><slot name="head"/></head><body><a class="skip-link" href="#main">Skip to content</a><Header active={active}/><main id="main"><slot/></main><Footer/></body></html>
