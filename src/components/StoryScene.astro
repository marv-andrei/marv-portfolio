---
import {projects} from '../data/projects';
const shots=Object.fromEntries(projects.map(p=>[p.id,{name:p.name,kind:p.kind}]));
---
<div class="st-stage" aria-hidden="true"><canvas id="st-scene" data-projects={JSON.stringify(shots)}></canvas><span class="st-hint" id="st-hint">Scroll</span><div class="st-tag" id="st-tag"><b id="st-tag-name"></b><span id="st-tag-sub"></span></div></div>
<noscript><style>{'@media(max-width:820px){.st-stage{display:none}}'}</style></noscript>
<script>
// The scene is decoration, so it waits until the page itself is idle, and is skipped for data-saver visitors.
const story=document.getElementById('st-story'), conn=(navigator as any).connection;
const start=()=>import('../scripts/story-scene.js').catch(()=>story?.classList.add('st-off'));
if(conn&&conn.saveData) story?.classList.add('st-off');
else if('requestIdleCallback' in window) requestIdleCallback(start,{timeout:1200});
else setTimeout(start,150);

// Related projects are stops on a rail. The marble sits at the stop in play; pointing at a stop tells the 3D piece,
// and the piece tells this when a visitor uses it (the laptop's build, the parcel's stop, the gears).
const lines=[...document.querySelectorAll<HTMLElement>('.st-stops')];
const place=(ol:HTMLElement)=>{
  const on=ol.querySelector<HTMLElement>('li.is-on .st-rung'), m=ol.querySelector<HTMLElement>('.st-marble'); if(!on||!m) return;
  const a=on.getBoundingClientRect(), b=ol.getBoundingClientRect();
  m.style.transform=`translate(${a.left-b.left+ol.scrollLeft+a.width/2-11}px,${a.top-b.top+a.height/2-11}px)`; m.classList.add('set');
};
const pick=(li:Element|null,tell:boolean)=>{
  if(!li||li.classList.contains('is-on')) return; const ol=li.parentElement as HTMLElement;
  ol.querySelectorAll('li.is-on').forEach(x=>x.classList.remove('is-on')); li.classList.add('is-on'); place(ol);
  if(tell) window.dispatchEvent(new CustomEvent('st-project',{detail:li.querySelector('a')?.dataset.project}));
};
lines.forEach(ol=>{
  ol.querySelectorAll('a').forEach(a=>{const li=a.parentElement; a.addEventListener('pointerenter',()=>pick(li,true)); a.addEventListener('focus',()=>pick(li,true));});
  ol.firstElementChild?.classList.add('is-on');
});
const placeAll=()=>lines.forEach(place);
window.addEventListener('st-scene-project',e=>pick(document.querySelector(`.st-stops a[data-project="${(e as CustomEvent).detail}"]`)?.parentElement??null,false));
window.addEventListener('resize',placeAll); window.addEventListener('load',placeAll); document.fonts?.ready.then(placeAll); placeAll();
</script>
