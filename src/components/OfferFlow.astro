---
// The four offers shown as one working line: an enquiry leaves the page, lands in the CRM,
// sets off the automations and the site is looked after. Each stage is a small dark screen
// that plays its part in turn, with the orange marble from the story rolling along a rail
// under them. Decorative: the offers themselves are plain text beside each screen.
const steps=[
 {id:'web',title:'Websites',lead:'Pages built around the one action they have to earn.',body:'Shopify storefronts, WordPress and Elementor sites, landing pages and advertorials, checked on every screen before launch.',href:'https://vendrato.com/websites',link:'Vendrato websites'},
 {id:'crm',title:'CRM systems',lead:'Every enquiry lands in the pipeline, with nothing retyped.',body:'GoHighLevel funnels, forms, booking and lead capture. Larger setups, migration and team training are done with the rest of the studio.',href:'https://vendrato.com/crm',link:'Vendrato CRM systems'},
 {id:'auto',title:'Automations',lead:'The next step happens on its own.',body:'GoHighLevel workflows and Make or n8n scenarios that move data between your form, CRM and inbox, mapped first and tested before they run on real leads.',href:'https://vendrato.com/automations',link:'Vendrato automations'},
 {id:'care',title:'Care after launch',lead:'The site you launched keeps working.',body:'Four hours of support each month for minor revisions, security patches and routine upkeep. Larger changes are scoped separately.',href:'https://vendrato.com/websites',link:'Vendrato maintenance'},
];
---
<div class="st-flow" id="st-flow" style="--k:0">
<div class="st-flow-bar"><button type="button" class="st-send" id="st-send">Send a test enquiry</button><p id="st-flow-note">Press it and follow one enquiry through all four.</p></div>
<div class="st-flow-grid">

<div class="st-box" data-i="0" style="--i:0" aria-hidden="true"><svg viewBox="0 0 240 170">
<rect class="ln" x="14" y="14" width="212" height="142" rx="6"/><path class="ln" d="M14 36h212"/><circle class="dot" cx="27" cy="25" r="2.4"/><circle class="dot" cx="37" cy="25" r="2.4"/><circle class="dot" cx="47" cy="25" r="2.4"/>
<rect class="bar" x="32" y="54" width="112" height="11" rx="2"/><rect class="bar dim" x="32" y="74" width="84" height="6" rx="2"/><rect class="bar dim" x="32" y="86" width="98" height="6" rx="2"/>
<rect class="ln mut" x="160" y="54" width="50" height="62" rx="3"/><path class="ln mut" d="M160 100l16-16 12 12 8-8 14 14"/>
<circle class="ring" cx="67" cy="122" r="16"/><g class="btn"><rect class="or" x="32" y="110" width="70" height="24" rx="4"/><rect x="45" y="120" width="44" height="4" rx="2" fill="#000" opacity=".5"/></g>
<circle class="tok" cx="67" cy="122" r="6.5"/></svg></div>

<div class="st-box" data-i="1" style="--i:1" aria-hidden="true"><svg viewBox="0 0 240 170">
<rect class="ln" x="14" y="14" width="64" height="142" rx="6"/><rect class="ln" x="88" y="14" width="64" height="142" rx="6"/><rect class="ln" x="162" y="14" width="64" height="142" rx="6"/>
<text x="24" y="33">New</text><text x="98" y="33">Booked</text><text x="172" y="33">Won</text>
<rect class="ln mut" x="21" y="42" width="50" height="20" rx="3"/><rect class="ln mut" x="21" y="68" width="50" height="20" rx="3"/><rect class="ln mut" x="95" y="42" width="50" height="20" rx="3"/><rect class="ln mut" x="169" y="42" width="50" height="20" rx="3"/>
<g class="card"><rect class="or" x="21" y="94" width="50" height="20" rx="3"/><rect x="28" y="101" width="26" height="3" rx="1.5" fill="#000" opacity=".5"/><rect x="28" y="107" width="16" height="3" rx="1.5" fill="#000" opacity=".5"/></g></svg></div>

<div class="st-box" data-i="2" style="--i:2" aria-hidden="true"><svg viewBox="0 0 240 170">
<path class="wire" d="M70 85C83 85 79 40 92 40"/><path class="wire" d="M70 85C83 85 79 130 92 130"/><path class="wire" d="M148 40C161 40 157 85 170 85"/><path class="wire" d="M148 130C161 130 157 85 170 85"/>
<path class="wire hot h1" pathLength="1" d="M70 85C83 85 79 40 92 40"/><path class="wire hot h1" pathLength="1" d="M70 85C83 85 79 130 92 130"/><path class="wire hot h2" pathLength="1" d="M148 40C161 40 157 85 170 85"/><path class="wire hot h2" pathLength="1" d="M148 130C161 130 157 85 170 85"/>
<g class="node n1"><rect x="14" y="69" width="56" height="32" rx="5"/><text x="42" y="89" text-anchor="middle">Form</text></g>
<g class="node n2"><rect x="92" y="24" width="56" height="32" rx="5"/><text x="120" y="44" text-anchor="middle">CRM</text></g>
<g class="node n2"><rect x="92" y="114" width="56" height="32" rx="5"/><text x="120" y="134" text-anchor="middle">Inbox</text></g>
<g class="node n3"><rect x="170" y="69" width="56" height="32" rx="5"/><text x="198" y="89" text-anchor="middle">Calendar</text></g></svg></div>

<div class="st-box" data-i="3" style="--i:3" aria-hidden="true"><svg viewBox="0 0 240 170">
<rect class="ln" x="14" y="14" width="212" height="142" rx="6"/><path class="ln" d="M14 36h212"/><circle class="dot" cx="27" cy="25" r="2.4"/><circle class="dot" cx="37" cy="25" r="2.4"/><circle class="dot" cx="47" cy="25" r="2.4"/>
<g class="row r1"><circle class="ln mut" cx="44" cy="62" r="10"/><path class="tick" pathLength="1" d="M39 62l4 4 7-8"/><text x="64" y="66">Revisions made</text></g>
<g class="row r2"><circle class="ln mut" cx="44" cy="96" r="10"/><path class="tick" pathLength="1" d="M39 96l4 4 7-8"/><text x="64" y="100">Security patched</text></g>
<g class="row r3"><circle class="ln mut" cx="44" cy="130" r="10"/><path class="tick" pathLength="1" d="M39 130l4 4 7-8"/><text x="64" y="134">Still working</text></g></svg></div>

<div class="st-rail" aria-hidden="true"><i></i><i></i><i></i><i></i><b></b></div>

{steps.map((s,i)=><article class="st-step" data-i={i} style={`--i:${i}`}><h3>{s.title}</h3><p class="st-lead">{s.lead}</p><p>{s.body}</p><a class="text-link" href={s.href}>{s.link}</a></article>)}
</div>
</div>
<script>
const flow=document.getElementById('st-flow');
if(flow){
  const boxes=[...flow.querySelectorAll('.st-box')], texts=[...flow.querySelectorAll('.st-step')];
  const note=document.getElementById('st-flow-note')!, send=document.getElementById('st-send')!;
  const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
  const HOLD=[2000,2700,2700,2600];
  const NOTES=['A visitor presses the button on the page.','The enquiry lands in the pipeline and gets booked.','The form, CRM, inbox and calendar are all told, with nobody typing.','A month on, the site is still patched and working.'];
  let timer=0, auto=true, seen=false;
  // n: -1 nothing yet, 0 to 3 that stage is playing, 4 all finished
  const set=(n:number)=>{
    boxes.forEach((b,i)=>{b.classList.toggle('on',i===n); b.classList.toggle('done',i<n);});
    texts.forEach((t,i)=>t.classList.toggle('on',i===n));
    flow.style.setProperty('--k',String(Math.max(0,Math.min(3,n))));
    note.textContent=n<0?'Press it and follow one enquiry through all four.':n>3?'That was one enquiry. Press it to send another.':NOTES[n];
  };
  const run=(n:number)=>{
    clearTimeout(timer); set(n);
    if(n<4) timer=window.setTimeout(()=>run(n+1),HOLD[n]);
    else if(auto) timer=window.setTimeout(()=>{set(-1); timer=window.setTimeout(()=>run(0),1400);},3400);
  };
  // stacked on small screens: each screen plays as it scrolls into view, since only one is visible at a time
  const stacked=matchMedia('(max-width:820px)').matches;
  const play=(b:Element)=>{b.classList.remove('done'); b.classList.add('on'); window.setTimeout(()=>{b.classList.remove('on'); b.classList.add('done');},HOLD[Number((b as HTMLElement).dataset.i)]);};
  if(reduced){ set(4); send.hidden=true; note.textContent='One enquiry, from the page to the pipeline to the follow-up.'; }
  else{
    if(stacked){
      note.textContent='Scroll on and follow one enquiry through all four.'; send.hidden=true;
      boxes.forEach(b=>b.addEventListener('click',()=>play(b)));
    } else {
      send.addEventListener('click',()=>{auto=false; run(0);});
      boxes[0].addEventListener('click',()=>{auto=false; run(0);});
    }
  }
  // rise into view once, and only play while on screen
  const rise=[flow];
  rise.forEach(el=>el.classList.add('st-anim'));
  if('IntersectionObserver' in window){
    const io=new IntersectionObserver(es=>es.forEach(e=>{
      if(e.isIntersecting) e.target.classList.add('in');
      if(e.target===flow&&!reduced&&!stacked){ if(e.isIntersecting){ if(!seen||auto){seen=true; run(0);} } else clearTimeout(timer); }
    }),{threshold:.25});
    rise.forEach(el=>io.observe(el));
    if(stacked&&!reduced){ const each=new IntersectionObserver(es=>es.forEach(e=>{ if(e.isIntersecting&&!e.target.classList.contains('done')&&!e.target.classList.contains('on')) play(e.target); }),{threshold:.7}); boxes.forEach(b=>each.observe(b)); }
  } else { rise.forEach(el=>el.classList.add('in')); if(!reduced&&!stacked) run(0); }
}
</script>
