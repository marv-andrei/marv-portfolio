---
import Site from '../layouts/Site.astro';
---
<Site title="Let’s talk" description="Contact Marv about landing-page projects or agency roles. Available during Australian working hours, with typical page turnaround of one to two days depending on complexity." active="contact"><section class="wrap contact-layout"><div class="contact-intro"><p class="section-context">Let’s work together</p><h1>Have something<br>in mind?</h1><p>Have a page brief or a role in mind? Tell me about the platform, the scope and when you need it.</p><div class="brief-builder" hidden><p>What do you need a hand with?</p><div class="brief-options" role="group" aria-label="Project type">{['Shopify storefront','Landing page','Funnel support','Agency role'].map(x=><button type="button" aria-pressed="false" data-brief={x}>{x}</button>)}</div><p class="brief-result" role="status" aria-live="polite">Choose a starting point to prepare your enquiry.</p><a class="button button-blue brief-email" href="mailto:pacinabaomarv@gmail.com">Start an email</a><small>Opens your email app with a draft you can edit.</small></div><a class="email-link" href="mailto:pacinabaomarv@gmail.com">pacinabaomarv@gmail.com </a><button type="button" class="copy-email" hidden>Copy email address</button><p class="copy-status" role="status" aria-live="polite"></p><div class="social-links"><a href="https://www.linkedin.com/in/marv-andrei-pacinabao/" target="_blank" rel="noopener noreferrer">LinkedIn </a><a href="https://wa.me/639625394327" target="_blank" rel="noopener noreferrer">WhatsApp </a><a href="https://www.facebook.com/arvie.pacinabao/" target="_blank" rel="noopener noreferrer">Facebook </a></div></div><aside class="availability"><h2>Here’s the practical stuff.</h2><dl><div><dt>Working hours</dt><dd>9 am–5 pm, Australian hours.<small>Specific time zone agreed with your team.</small></dd></div><div><dt>Typical page turnaround</dt><dd>1–2 days, depending on complexity.<small>From a completed design and copy brief, with scope and access confirmed.</small></dd></div><div><dt>Based in</dt><dd>The Philippines.<small>Working remotely with brands and agencies.</small></dd></div></dl><a class="text-link" href="/resume/">View my résumé </a></aside></section></Site>
<script>
const brief=document.querySelector<HTMLElement>('.brief-builder');
if(brief){brief.hidden=false;const link=brief.querySelector<HTMLAnchorElement>('.brief-email')!;const result=brief.querySelector<HTMLElement>('.brief-result')!;const options=[...brief.querySelectorAll<HTMLButtonElement>('[data-brief]')];options.forEach(option=>option.addEventListener('click',()=>{options.forEach(b=>b.setAttribute('aria-pressed',String(b===option)));const type=option.dataset.brief!;const body=`Hi Marv,\n\nI’d like to discuss a ${type.toLowerCase()}.\n\nMy website or brand: \nWhat I need: \nTarget start date: \n\nThanks!`;link.href=`mailto:pacinabaomarv@gmail.com?subject=${encodeURIComponent(type+' enquiry')}&body=${encodeURIComponent(body)}`;result.textContent=`${type} selected. Your email draft will include space for the scope and timing.`;}));}
const button=document.querySelector<HTMLButtonElement>('.copy-email');const status=document.querySelector<HTMLElement>('.copy-status');
if(button&&status&&navigator.clipboard){button.hidden=false;button.addEventListener('click',async()=>{try{await navigator.clipboard.writeText('pacinabaomarv@gmail.com');status.textContent='Email address copied.';}catch{status.textContent='Copy didn’t work. Select the email address above, or click it to open your email app.';}});}
</script>
