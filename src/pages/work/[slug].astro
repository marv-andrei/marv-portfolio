---
import Site from '../../layouts/Site.astro';
import ContactBand from '../../components/ContactBand.astro';
import {projects} from '../../data/projects';
export function getStaticPaths(){return projects.map((project,index)=>({params:{slug:project.id},props:{project,next:projects[(index+1)%projects.length]}}));}
const {project:p,next}=Astro.props;
---
<Site title={`${p.name} project`} description={p.description} active="work" socialImage={`/images/shots/${p.id}.jpg`}><section class="wrap project-intro"><a href="/work/" class="back-link"> All work</a><div class="project-title-row"><div><p class="section-context">{p.kind}</p><h1>{p.name}</h1></div><a class="button button-blue" href={p.url} target="_blank" rel="noopener noreferrer">View live example </a></div><p class="case-lead">{p.description}</p><dl class="project-facts"><div><dt>Platform</dt><dd>{p.platform.replace('Shopify Funnelish','Shopify / Funnelish')}</dd></div><div><dt>My contribution</dt><dd>{p.scope}</dd></div><div><dt>Page format</dt><dd>{p.kind}</dd></div></dl></section><div class="wrap"><div class="case-image" style={`--project-bg:${p.color}`}><img src={`/images/shots/${p.id}.webp`} width="1440" height="1000" alt={`${p.name} page screenshot`} fetchpriority="high"/></div></div><section class="wrap case-story"><h2>About the build.</h2><div><p>{p.note}</p>{p.id==='artin'&&<p>The second example uses a comfort-shoe comparison story to introduce the product to readers weighing their options.</p>}<div class="case-links"><a class="text-link" href={p.url} target="_blank" rel="noopener noreferrer">Explore the live page </a>{p.extra&&<a class="text-link" href={p.extra} target="_blank" rel="noopener noreferrer">Comfort-shoe advertorial </a>}</div><p class="case-note">Project preview from the portfolio. Live pages may include later updates by the brand.</p></div></section><section class="wrap next-project"><p class="section-context">Keep exploring</p><a href={`/work/${next.id}/`}><span>{next.name}</span></a></section><ContactBand/></Site>
