---
import { render } from 'astro:content';
import Site from '../../layouts/Site.astro';
import { getPosts, formatDate } from '../../data/blog';
import '../../styles/blog.css';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, next: posts[i + 1] ?? posts[0] } }));
}

const { post, next } = Astro.props;
const { Content } = await render(post);
const url = new URL(`/blog/${post.id}/`, Astro.site);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: { '@type': 'Person', name: 'Marv Pacinabao', url: 'https://marvpacinabao.com/about/' },
  mainEntityOfPage: url.href,
};
---
<Site title={post.data.title} description={post.data.description} active="blog" type="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article class="wrap post">
    <header class="post-head">
      <a class="post-back" href="/blog/">All articles</a>
      <div class="blog-meta">
        <span>{post.data.topic}</span>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span>{post.data.readingTime} read</span>
      </div>
      <h1>{post.data.title}</h1>
      <p class="post-lede">{post.data.description}</p>
    </header>
    <div class="post-body">
      <Content />
    </div>
    <aside class="post-cta" aria-label="Work with Marv">
      <p>Want a second pair of eyes on your pages or funnel?</p>
      <p class="post-cta-sub">I build and fix landing pages, storefronts and the CRM and automations behind them. Tell me what you're working on.</p>
      <div class="post-cta-actions">
        <a class="button button-blue" href="/contact/">Send me a message</a>
        <a class="text-link" href="/work/">See my work</a>
      </div>
    </aside>
    {next && next.id !== post.id && (
      <nav class="post-next" aria-label="Next article">
        <span>Read next</span>
        <a href={`/blog/${next.id}/`}>{next.data.title}</a>
      </nav>
    )}
  </article>
</Site>
